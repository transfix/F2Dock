staticMolecule tests/1A2K_R_U_1.7.f2d
movingMolecule tests/1A2K_L_U.f2d
staticMoleculePQR tests/1A2K_R_U.pqr
movingMoleculePQR tests/1A2K_L_U.pqr
staticMoleculeQUAD tests/1A2K_R_U.quad
movingMoleculeQUAD tests/1A2K_L_U.quad
rmsdAtoms tests/1A2K_rmsd_backbone_unbound_10.0.txt
outFile tests/integration/expected/1A2K_flex_smoke_out.txt

rotFile deg15.mtx
numRot 54
effGridFile fftw-rank.txt

complexType G
